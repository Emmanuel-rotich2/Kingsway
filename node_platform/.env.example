# Node.js Gateway Environment Configuration
# Copy to .env and fill in actual values
# NEVER commit .env to git!

NODE_ENV=development

# JWT Configuration (shared with PHP)
JWT_SECRET=your-64-char-secret-here-minimum-32-chars
JWT_ISSUER=kingsway-prep-school
JWT_AUDIENCE=kingsway-staff

# Worker Secret (shared with PHP/Python for internal API calls)
KINGSWAY_WORKER_SECRET=your-worker-secret-here

# Browser-origin allowlist (comma-separated)
# MUST be the PHP site origin, NOT the gateway origin
NODE_REALTIME_WEB_ORIGIN=https://localhost,http://localhost

# Optional: override storage root (default: project_root/storage/realtime)
# STORAGE_ROOT=/home/prof_angera/realtime_app/storage

# Optional: override instance ID for multi-instance deployments
# NODE_REALTIME_INSTANCE_ID=gateway-1
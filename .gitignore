# --------------------------------------------------------
# Runtime uploads (environment-owned — never tracked)
# Template/asset changes needing manual production promotion
# belong in uploads_backup/, then production copies them
# into its own uploads/ tree.
# --------------------------------------------------------
/uploads/
!/uploads_backup/

# Personal data / PII inside uploads_backup (never tracked)
/uploads_backup/cvs/
/uploads_backup/staff/profile_pictures/
/uploads_backup/students/avatar.jpg


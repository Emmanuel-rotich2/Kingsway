{
    "name": "angisoft/kingsway",
    "description": "Private CBC school-management system for Kingsway Preparatory School, maintained by Angisoft Technologies.",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "phpmailer/phpmailer": "^6.8",
        "firebase/php-jwt": "^7.0",
        "endroid/qr-code": "^5.0",
        "phpoffice/phpspreadsheet": "^5.0",
        "tecnickcom/tcpdf": "^6.6",
        "psr/log": "^3.0",
        "symfony/polyfill-intl-idn": "^1.29",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpword": "^1.4",
        "africastalking/africastalking": "^3.0",
        "lbuchs/webauthn": "1.1.3",
        "webklex/php-imap": "*"

    },
    "autoload": {
        "psr-4": {
            "App\\": "./",
            "App\\API\\": "api/",
            "App\\API\\Modules\\": "api/modules/",           
            "App\\API\\Includes\\": "api/includes/",
            "App\\API\\Middleware\\": "api/middleware/",
            "App\\API\\Core\\": "api/core/",
            "App\\Config\\": "config/",
            "App\\Database\\": "database/",
            "App\\API\\Services\\": "api/services/",
            "App\\API\\Controllers\\": "api/controllers/",
            "App\\API\\Router\\": "api/router/"
},
        "files": [
            "api/includes/helpers.php",
            "config/asset_helpers.php",
            "config/public_helpers.php",
            "config/school_identity.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit",
        "ai:smoke": "php .github/scripts/ai_provider_smoke.php --live",
        "ai:resilience": "php .github/scripts/ai_resilience_smoke.php",
        "check:assets": "php scripts/check_asset_versioning.php",
        "check:logging": "php scripts/check_logging_policy.php",
        "test:logging": "php scripts/test_logging_system.php"
    }
}
